cabal-version: 3.14
name: ecx-pool
version: 0.1.0.0
synopsis: Separate Orca full-range liquidity operations
license: MIT
build-type: Simple
data-files: test/published-pool.json

library
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Wcompat
  hs-source-dirs: .
  exposed-modules: Pool, Pool.Signing, Pool.Position, Pool.Liquidity, Pool.Operation
  build-depends: base, ecx-bridge, ecx-bridge:chain,
    aeson, binary, bytestring, text, unix, http-client, http-types, time, base64-bytestring, crypton, ram

executable ecx-pool
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, ecx-pool, ecx-build-assets, ecx-bridge, http-client, aeson, bytestring, text

test-suite pool-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  hs-source-dirs: test
  main-is: Main.hs
  build-tool-depends: ecx-pool:ecx-pool
  autogen-modules: Paths_ecx_pool
  other-modules: Paths_ecx_pool
  build-depends: base, ecx-pool, ecx-bridge, ecx-bridge:chain, ecx-build-assets, QuickCheck, aeson, bytestring, text, base64-bytestring, crypton, ram, process, network
