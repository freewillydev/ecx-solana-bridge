[Unit]
Description=ECX bridge private worker
After=network-online.target ecx-bridge-node.service ecx-bridge-postgres.service
Requires=ecx-bridge-postgres.service
Wants=network-online.target

[Service]
Type=simple
User=ecx-worker
Group=ecx-api
SupplementaryGroups=ecx-worker ecx-node
UMask=0077
EnvironmentFile=/etc/ecx-bridge/postgres.env
EnvironmentFile=-/etc/ecx-bridge/interface.env
EnvironmentFile=-/etc/ecx-bridge/fence.env
ExecStart=/opt/ecx-bridge/current/bin/ecx-bridge postgres-api /etc/ecx-bridge/worker.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=ecx-bridge
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecx-bridge/private /var/lib/ecx-bridge/fence /run/ecx-bridge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
LimitNOFILE=1024
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
