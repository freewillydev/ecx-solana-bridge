#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
test "$(pkg-config --modversion sqlite3)" = 3.53.4 || {
  echo 'Select SQLite 3.53.4 using PKG_CONFIG_PATH before building.' >&2
  exit 1
}
sqlite_lib=$(pkg-config --variable=libdir sqlite3)
sqlite_include=$(pkg-config --variable=includedir sqlite3)
sqlite_prefix=$(pkg-config --variable=prefix sqlite3)
PATH="$sqlite_prefix/bin:$PATH"
export PATH
cabal build all --extra-lib-dirs="$sqlite_lib" --extra-include-dirs="$sqlite_include"
cabal test all --test-show-details=direct --extra-lib-dirs="$sqlite_lib" --extra-include-dirs="$sqlite_include"
# Compile the manual public-network probe without running it or touching a wallet.
cabal exec -- ghc -fno-code -package ecx-bridge scripts/native-unsigned-probe.hs
cabal exec -- ghc -fno-code -package ecx-bridge scripts/native-admission-probe.hs
cabal exec -- ghc -fno-code -package ecx-bridge scripts/solana-probe.hs
cabal exec -- ghc -fno-code -package ecx-bridge scripts/solana-admission-probe.hs
cabal exec -- ghc -fno-code -package ecx-bridge scripts/public-test-order.hs
cabal exec -- ghc -fno-code -package ecx-bridge scripts/provisioning-probe.hs
cargo test --locked --manifest-path solana-helper/Cargo.toml --all-targets
cargo fmt --check --manifest-path solana-helper/Cargo.toml
npm ci --prefix web --ignore-scripts
npm run check --prefix web
npm run build --prefix web
npm audit --prefix web
python3 test/installer_test.py
