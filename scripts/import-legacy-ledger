#!/usr/bin/env python3
"""Import a consistent schema-18 snapshot into an EMPTY PostgreSQL schema.

Maintenance-only tool. libpq PG* settings select the private destination. Output
contains counts/digests only; SQL/data/error details are never logged. This does
not switch a worker, resume intake, or authorize any external payment.
"""
import argparse
import csv
import hashlib
import io
import json
import os
import re
import sqlite3
import subprocess
from pathlib import Path

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('snapshot', type=Path)
parser.add_argument('--report', required=True, type=Path)
args = parser.parse_args()
os.umask(0o077)
source = sqlite3.connect(args.snapshot.resolve().as_uri()+'?mode=ro', uri=True)
source.execute('PRAGMA query_only=ON')
source.execute('BEGIN')
if source.execute('PRAGMA integrity_check').fetchall() != [('ok',)]:
    raise SystemExit('snapshot integrity failed')
metadata = source.execute('SELECT schema_version,fingerprint,critical_sequence FROM deployment').fetchall()
if len(metadata)!=1 or metadata[0][0]!=18:
    raise SystemExit('schema-18 snapshot required')
schema = json.loads((root/'migrations/postgresql/schema-map.json').read_text())
actual = {row[0] for row in source.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")}
if actual != set(schema['table']):
    raise SystemExit('snapshot table set mismatch')
order = re.findall(r'CREATE TABLE (\w+)\(', (root/'migrations/postgresql/001.sql').read_text())
if set(order)!=actual:
    raise SystemExit('target dependency order mismatch')

def quote(identifier):
    if not re.fullmatch(r'[a-z_]+',identifier):
        raise SystemExit('invalid schema identifier')
    return '"'+identifier+'"'

def digest(rows):
    encoded=sorted(json.dumps(row,separators=(',',':'),ensure_ascii=False) for row in rows)
    return hashlib.sha256(json.dumps(encoded,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()

expected={}
statements=['BEGIN;', 'SELECT pg_advisory_xact_lock(1162041393,18);']
for table in order:
    statements.append(f"DO $$ BEGIN IF EXISTS (SELECT 1 FROM {quote(table)}) THEN RAISE EXCEPTION 'destination_not_empty'; END IF; END $$;")
    statements.append(f'ALTER TABLE {quote(table)} DISABLE TRIGGER USER;')
for table in order:
    columns=[row['name'] for row in schema['columns'][table]]
    live_columns=[row[1] for row in source.execute(f'PRAGMA table_info({quote(table)})')]
    if columns!=live_columns:
        raise SystemExit('snapshot column mapping mismatch')
    selected=','.join(map(quote,columns))
    rows=source.execute(f'SELECT {selected} FROM {quote(table)}').fetchall()
    expected[table]={'rows':len(rows),'sha256':digest(rows)}
    statements.append(f"COPY {quote(table)} ({selected}) FROM STDIN WITH (FORMAT csv, NULL '\\N');")
    for row in rows:
        fields=[]
        for value in row:
            if value is None:
                fields.append('\\N')
            else:
                stream=io.StringIO(newline='')
                csv.writer(stream,quoting=csv.QUOTE_ALL,lineterminator='').writerow([value])
                fields.append(stream.getvalue())
        statements.append(','.join(fields))
    statements.append('\\.')
for table in order:
    statements.append(f'ALTER TABLE {quote(table)} ENABLE TRIGGER USER;')
    identity=next((column for column in schema['columns'][table] if column['name']=='id' and column['type']=='INTEGER' and column['primaryKey']),None)
    if identity:
        statements.append(f"SELECT setval(pg_get_serial_sequence('{table}','id'),COALESCE((SELECT MAX(id) FROM {quote(table)}),1),EXISTS(SELECT 1 FROM {quote(table)}));")
    selected=','.join(quote(column['name']) for column in schema['columns'][table])
    statements.append(f"SELECT json_build_object('table','{table}','row',row_to_json(t)) FROM (SELECT {selected} FROM {quote(table)}) t;")
# Verify the uncommitted PostgreSQL view before authorizing COMMIT.
import queue
import threading
statements.append("SELECT '{\"verification_complete\":true}'::json;")
process=subprocess.Popen(['psql','-X','-q','-t','-A','-v','ON_ERROR_STOP=1'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
messages=queue.Queue()
def reader():
    for line in process.stdout:
        messages.put(line)
    messages.put(None)
def writer():
    try:
        process.stdin.write('\n'.join(statements)+'\n')
        process.stdin.flush()
    except (BrokenPipeError,OSError):
        pass
threading.Thread(target=reader,daemon=True).start()
threading.Thread(target=writer,daemon=True).start()
observed={table:[] for table in order}
try:
    while True:
        line=messages.get(timeout=60)
        if line is None:
            raise ValueError('destination import failed')
        try:
            item=json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(item,dict):
            continue
        if item.get('verification_complete'):
            break
        if 'table' in item:
            table=item['table']
            columns=[column['name'] for column in schema['columns'][table]]
            observed[table].append(tuple(item['row'][column] for column in columns))
    verified={table:{'rows':len(rows),'sha256':digest(rows)} for table,rows in observed.items()}
    if expected!=verified:
        raise ValueError('record comparison failed')
    process.stdin.write('COMMIT;\n')
    process.stdin.close()
    if process.wait(timeout=60)!=0:
        raise ValueError('destination commit failed or uncertain')
except Exception as error:
    if process.poll() is None:
        process.terminate()
        process.wait(timeout=10)
    raise SystemExit(str(error) if isinstance(error,ValueError) else 'import failed; destination requires inspection')
source.close()
args.report.parent.mkdir(parents=True,exist_ok=True)
args.report.write_text(json.dumps({'legacySchemaVersion':18,'criticalSequence':metadata[0][2],
    'tableComparisons':verified,'allRecordsMatch':True,'workerSwitched':False},indent=2)+'\n')
os.chmod(args.report,0o600)
print(json.dumps({'tablesVerified':len(verified),'recordsVerified':sum(item['rows'] for item in verified.values()),'allRecordsMatch':True,'workerSwitched':False}))
