#!/usr/bin/env python3
"""Translate the final legacy schema, never a live ledger or its contents.

The generated DDL is reviewed/versioned, not run dynamically at worker startup.
Unknown trigger/SQL constructs fail generation rather than dropping protection.
"""
import json
import re
import sqlite3
from pathlib import Path

root = Path(__file__).resolve().parent.parent
connection = sqlite3.connect(':memory:')
for migration in sorted((root / 'migrations').glob('[0-9][0-9][0-9].sql')):
    connection.executescript(migration.read_text())
    if migration.name == '001.sql':
        connection.execute("INSERT INTO deployment(singleton,schema_version,fingerprint) VALUES(1,1,'schema-generation-only')")
objects = connection.execute("SELECT type,name,tbl_name,sql FROM sqlite_master WHERE sql IS NOT NULL AND name NOT LIKE 'sqlite_%' ORDER BY rowid").fetchall()


def translate(sql):
    # Retain flags as constrained integers to preserve the legacy encoding.
    sql = re.sub(r"typeof\((\w+)\)='integer' AND ", '', sql)
    sql = re.sub(r'\bINTEGER\b', 'BIGINT', sql)
    sql = re.sub(r'\bjson_valid\(', 'bridge_json_valid(', sql)
    sql = re.sub(r'\bunixepoch\(\)', 'floor(extract(epoch FROM clock_timestamp()))::bigint', sql)
    sql = re.sub(r'\bMAX\(last_time,', 'GREATEST(last_time,', sql)
    sql = re.sub(r'(NEW\.\w+) IS NOT (OLD\.\w+)', r'\1 IS DISTINCT FROM \2', sql)
    if any(token in sql for token in ('typeof(', 'RAISE(', 'unixepoch(', ' IS NOT OLD.')):
        raise ValueError('untranslated SQL: ' + sql)
    return sql


def trigger(sql):
    match = re.fullmatch(r'CREATE TRIGGER (\w+) (BEFORE|AFTER) (UPDATE(?: OF [\w,]+)?|INSERT|DELETE) ON (\w+)(?: WHEN (.*?))? BEGIN (.*?) END', sql, re.S)
    if not match:
        raise ValueError('unsupported trigger: ' + sql)
    name, timing, event, table, condition, body = match.groups()
    body = re.sub(r"SELECT RAISE\(ABORT,'([\w]+)'\);", r"RAISE EXCEPTION '\1' USING ERRCODE='23514';", body)
    body = translate(body)
    if condition:
        body = 'IF ' + translate(condition) + ' THEN ' + body + ' END IF;'
    returned = 'OLD' if event == 'DELETE' else 'NEW'
    return (f'CREATE FUNCTION trg_{name}() RETURNS trigger LANGUAGE plpgsql AS $body$\n'
            f'BEGIN {body} RETURN {returned}; END\n$body$;\n'
            f'CREATE TRIGGER {name} {timing} {event} ON {table} FOR EACH ROW EXECUTE FUNCTION trg_{name}();')

out = ['-- Generated by scripts/generate-postgres-schema from migrations 001..018.',
       '-- Fresh PostgreSQL financial schema; legacy schema version remains 18.',
       'BEGIN;',
       "CREATE FUNCTION bridge_json_valid(value text) RETURNS boolean LANGUAGE plpgsql IMMUTABLE STRICT AS $$ BEGIN PERFORM value::json; RETURN true; EXCEPTION WHEN invalid_text_representation THEN RETURN false; END $$;"]
tables = [x for x in objects if x[0] == 'table']
# Final SQLite table order is not dependency order after rename migrations.
pending = {name: sql for _, name, _, sql in tables}
created = set()
while pending:
    ready = [(name, sql) for name, sql in pending.items()
             if set(re.findall(r'REFERENCES (\w+)', sql)) <= created | {name}]
    if not ready:
        raise ValueError('cyclic or unknown table references: ' + ','.join(pending))
    for name, sql in ready:
        sql = translate(sql)
        # SQLite rowid allocation is explicit in PostgreSQL. Preserve import IDs.
        if re.search(r'\(id BIGINT PRIMARY KEY', sql):
            sql = sql.replace('(id BIGINT PRIMARY KEY', '(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY', 1)
        out.append(sql + ';')
        created.add(name)
        del pending[name]
for kind, name, table, sql in objects:
    if kind in ('index', 'view'):
        out.append(translate(sql) + ';')
for kind, name, table, sql in objects:
    if kind == 'trigger':
        out.append(trigger(sql))
out.append('COMMIT;')
output = root / 'migrations/postgresql/001.sql'
output.write_text('\n\n'.join(out) + '\n')
manifest = {kind: [name for typ, name, _, _ in objects if typ == kind]
            for kind in ('table', 'index', 'view', 'trigger')}
manifest['legacySchemaVersion'] = 18
manifest['columns'] = {name: [dict(name=row[1], type=row[2], nullable=not row[3] and not row[5], primaryKey=bool(row[5]))
                              for row in connection.execute(f'PRAGMA table_info("{name}")')]
                       for _, name, _, _ in tables}
(root / 'migrations/postgresql/schema-map.json').write_text(json.dumps(manifest, indent=2) + '\n')
print(json.dumps({kind: len(manifest[kind]) for kind in ('table', 'index', 'view', 'trigger')}))
