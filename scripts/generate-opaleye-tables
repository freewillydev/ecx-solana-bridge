#!/usr/bin/env python3
"""Generate explicit, inspectable Opaleye records from the checked schema map."""
import json
from pathlib import Path
root = Path(__file__).resolve().parent.parent
schema = json.loads((root/'migrations/postgresql/schema-map.json').read_text())
def camel(name):
    return ''.join(piece.capitalize() for piece in name.split('_'))
lines = ['{-# LANGUAGE TemplateHaskell, FlexibleInstances, MultiParamTypeClasses #-}',
         '-- Generated by scripts/generate-opaleye-tables; edit the schema map source.',
         'module Bridge.Postgres.Schema where', '',
         'import Data.Int (Int64)', 'import Data.Text (Text)',
         'import Data.Profunctor.Product.TH (makeAdaptorAndInstance)',
         'import qualified Opaleye as O', '']
for table, columns in schema['columns'].items():
    typ = camel(table)
    params = [f'a{i}' for i in range(len(columns))]
    prefix = table.replace('_','')
    selectors = [prefix+camel(column['name']) for column in columns]
    lines += [f'data {typ}F '+ ' '.join(params) + f' = {typ}',
              '  { '+ '\n  , '.join(f'{field} :: {param}' for field,param in zip(selectors,params))+'\n  } deriving (Eq,Show)',
              f'$(makeAdaptorAndInstance "p{typ}" \'\'{typ}F)', '']
    hs, read, write = [], [], []
    for column in columns:
        scalar = {'INTEGER': ('Int64','O.SqlInt8'), 'TEXT': ('Text','O.SqlText')}[column['type']]
        nullable = column['nullable']
        hs.append(f'(Maybe {scalar[0]})' if nullable else scalar[0])
        field = f'(O.FieldNullable {scalar[1]})' if nullable else f'(O.Field {scalar[1]})'
        read.append(field)
        generated = column['name']=='id' and column['type']=='INTEGER' and column['primaryKey']
        write.append(f'(Maybe {field})' if generated else field)
    for suffix, fields in [('',hs),('Read',read),('Write',write)]:
        lines.append(f'type {typ}{suffix} = {typ}F ' + ' '.join(fields))
    binding = prefix+'Table'
    lines += [f'{binding} :: O.Table {typ}Write {typ}Read',
              f'{binding} = O.table "{table}" $ p{typ} {typ}',
              '  { '+ '\n  , '.join(f'{field} = O.'+('optionalTableField' if column['name']=='id' and column['type']=='INTEGER' and column['primaryKey'] else 'requiredTableField')+f' "{column["name"]}"' for field,column in zip(selectors,columns))+'\n  }','']
(root/'src/Bridge/Postgres/Schema.hs').write_text('\n'.join(lines))
print(f'Generated {len(schema["columns"])} typed financial tables')
