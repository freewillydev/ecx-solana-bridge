#!/usr/bin/env python3
"""Build a Linux release as an unprivileged user, using pinned upstream tools."""
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import tarfile
import sys
import importlib.util

root = Path(__file__).resolve().parents[1]
arch = platform.machine()
if platform.system() != "Linux" or arch not in ("aarch64", "x86_64"):
    raise SystemExit("Ubuntu Linux required")
if os.geteuid() == 0:
    raise SystemExit("Build as an unprivileged user")
cache = Path(os.environ.get("ECX_BUILD_DIR", root / ".release-build")).resolve()
cache.mkdir(parents=True, exist_ok=True)
pins = json.loads((root / "deploy/toolchains.json").read_text())
tools = cache / "tools"
tools.mkdir(exist_ok=True)


def run(*args, cwd=root, **kw):
    subprocess.run(args, cwd=cwd, check=True, **kw)


def fetch(name):
    url, expected = pins["sqlite"] if name == "sqlite" else pins[arch][name]
    archive = cache / url.rsplit("/", 1)[1]
    if not archive.exists():
        temp = archive.with_suffix(".download")
        run("curl", "--fail", "--location", "--proto", "=https", "--retry", "3", "--output", str(temp), url)
        temp.rename(archive)
    digest = hashlib.sha3_256 if name == "sqlite" else hashlib.sha256
    with archive.open("rb") as f:
        if hashlib.file_digest(f, digest).hexdigest() != expected:
            raise ValueError(f"Checksum mismatch: {name}")
    target = cache / (name + "-source")
    if not (target / ".extracted").exists():
        if target.exists():
            shutil.rmtree(target)
        target.mkdir()
        with tarfile.open(archive) as t:
            t.extractall(target, filter="data")
        (target / ".extracted").touch()
    dirs = [p for p in target.iterdir() if p.is_dir()]
    return dirs[0] if len(dirs) == 1 else target


if not (tools / "bin/ghc").exists():
    source = fetch("ghc")
    run("./configure", f"--prefix={tools}", cwd=source)
    run("make", "install", cwd=source)
if not (tools / "bin/cabal").exists():
    shutil.copy2(fetch("cabal") / "cabal", tools / "bin/cabal")
if not (tools / "bin/rustc").exists():
    run("./install.sh", f"--prefix={tools}", "--components=rustc,cargo,rust-std-" + ("aarch64" if arch == "aarch64" else "x86_64") + "-unknown-linux-gnu,rustfmt-preview", "--disable-ldconfig", cwd=fetch("rust"))
# Keep the original notice bytes/paths before pruning expanded tool installers.
# The collector uses these cached small trees; compiler archives stay verified.
sys.dont_write_bytecode = True
notice_spec = importlib.util.spec_from_file_location("toolchain_notices", root / "deploy/toolchain-notices.py")
notice_module = importlib.util.module_from_spec(notice_spec)
notice_spec.loader.exec_module(notice_module)
for name in ("ghc-source", "rust-source"):
    expanded = cache / name
    if expanded.exists():
        notice_module.retain(expanded, tools / "notices" / name)
node = fetch("node")
os.environ["PATH"] = f"{tools}/bin:{node}/bin:" + os.environ["PATH"]
os.environ["CARGO_HOME"] = str(cache / "cargo")
os.environ["CARGO_TARGET_DIR"] = str(cache / "cargo-target")
os.environ["CABAL_DIR"] = str(cache / "cabal")
build_jobs = os.environ.get("ECX_BUILD_JOBS", "1")
if build_jobs not in ("1", "2"):
    raise ValueError("ECX_BUILD_JOBS must be 1 or 2")
os.environ["CARGO_BUILD_JOBS"] = build_jobs
# Test symbols are unnecessary for acceptance and consume substantial disk/link
# time in the Solana dependency graph. Release artifacts keep their own profile.
os.environ["CARGO_PROFILE_DEV_DEBUG"] = "0"
os.environ["CARGO_PROFILE_TEST_DEBUG"] = "0"
sqlite = cache / "sqlite"
if not (sqlite / "bin/sqlite3").exists():
    source = fetch("sqlite")
    run("./configure", f"--prefix={sqlite}", "--disable-readline", cwd=source)
    run("make", "-j2", cwd=source)
    run("make", "install", cwd=source)
os.environ["PATH"] = f"{sqlite}/bin:" + os.environ["PATH"]
os.environ["LD_LIBRARY_PATH"] = str(sqlite / "lib")
os.environ["PKG_CONFIG_PATH"] = str(sqlite / "lib/pkgconfig")
os.environ["LIBRARY_PATH"] = str(sqlite / "lib")
os.environ["C_INCLUDE_PATH"] = str(sqlite / "include")
# CI saves the expensive verified toolchains before any application build.
if os.environ.get("ECX_BOOTSTRAP_ONLY") == "1":
    raise SystemExit(0)
# Frozen dependencies do not require a network index refresh on every build.
# Refresh explicitly when updating pins, or populate an empty build cache.
index = cache / "cabal/packages/hackage.haskell.org/01-index.tar"
if not index.exists() or os.environ.get("ECX_REFRESH_INDEX") == "1":
    cabal_config = cache / "cabal/config"
    if not cabal_config.exists():
        run("cabal", "user-config", "init")
    # Use Hackage's official HTTPS content endpoint for fresh caches. Retain
    # signed repository verification and respect an explicitly configured URL.
    configuration = cabal_config.read_text()
    configuration = configuration.replace("url: http://hackage.haskell.org/", "url: https://hackage-content.haskell.org/")
    cabal_config.write_text(configuration)
    run("cabal", "update")
build_args = [f"--builddir={cache}/dist", f"--extra-lib-dirs={sqlite}/lib", f"--extra-include-dirs={sqlite}/include", "-j" + build_jobs]
run("cabal", "build", "all", *build_args)
run("cabal", "test", "all", "--test-show-details=direct", *build_args)
validator = subprocess.check_output(["cabal", "list-bin", "exe:ecx-tls-constraints-check", f"--builddir={cache}/dist"], cwd=root, text=True).strip()
run("python3", "integration/check-tls-constraints.py", "--validator", validator)
run("cargo", "test", "--locked", "--manifest-path", "solana-helper/Cargo.toml", "--all-targets")
run("cargo", "build", "--locked", "--release", "--manifest-path", "solana-helper/Cargo.toml")
# npm's content-addressed download cache avoids repeated fetches; retain a clean
# locked installation so a stale or edited node_modules cannot enter a release.
run("npm", "ci", "--prefix", "web", "--ignore-scripts", "--prefer-offline", "--no-audit", "--no-fund")
run("npm", "run", "check", "--prefix", "web")
run("npm", "run", "build", "--prefix", "web")
run("python3", "test/installer_test.py")
binary = subprocess.check_output(["cabal", "list-bin", "exe:ecx-bridge", f"--builddir={cache}/dist"], cwd=root, text=True).strip()
bundle = cache / "bundle"
if bundle.exists():
    shutil.rmtree(bundle)
for directory in ("bin", "lib", "web/dist", "deploy", "config", "migrations/postgresql", "scripts"):
    (bundle / directory).mkdir(parents=True, exist_ok=True)
shutil.copy2(binary, bundle / "bin/ecx-bridge")
shutil.copy2(cache / "cargo-target/release/ecx-solana-helper", bundle / "bin/ecx-solana-helper")
shutil.copy2((sqlite / "lib/libsqlite3.so").resolve(), bundle / "lib/libsqlite3.so.0")
shutil.copy2(sqlite / "bin/sqlite3", bundle / "bin/sqlite3")
for name in ("bitcoind", "bitcoin-cli"):
    shutil.copy2(fetch("bitcoin") / "bin" / name, bundle / "bin" / name)
for path in (root / "web").iterdir():
    if path.suffix in (".html", ".css"):
        shutil.copy2(path, bundle / "web" / path.name)
shutil.copytree(root / "web/dist", bundle / "web/dist", dirs_exist_ok=True)
shutil.copytree(root / "deploy", bundle / "deploy", ignore=shutil.ignore_patterns("__pycache__"), dirs_exist_ok=True)
shutil.copy2(root / "config/l2l-devnet.example.json", bundle / "config/l2l-devnet.example.json")
shutil.copy2(root / "config/interface.example.json", bundle / "config/interface.example.json")
shutil.copytree(root / "migrations/postgresql", bundle / "migrations/postgresql", dirs_exist_ok=True)
shutil.copy2(root / "scripts/import-legacy-ledger", bundle / "scripts/import-legacy-ledger")
shutil.copy2(root / "LICENSE", bundle / "LICENSE")
shutil.copy2(root / "docs/dependencies.json", bundle / "dependencies.json")
# Collect against this architecture's actual build, rather than copying another
# machine's dependency report. Every distributed notice is covered by the manifest.
run(str(root / "scripts/collect-notices"), str(cache), str(bundle / "notices"), "--fetch-missing")
coverage = json.loads((bundle / "notices/coverage.json").read_text())
if coverage["missing"]:
    raise ValueError("Release dependency notices are incomplete: " + ", ".join(coverage["missing"]))
for component in ("bitcoin-core", "sqlite"):
    notices = root / "docs/third-party" / component
    provenance = json.loads((notices / "provenance.json").read_text())
    for entry in provenance["files"]:
        if hashlib.sha256((notices / entry["path"]).read_bytes()).hexdigest() != entry["sha256"]:
            raise ValueError(component + " notice differs from its recorded source")
    shutil.copytree(notices, bundle / "notices" / component)
# The runtime must not regain the legacy SQLite dependency. SQLite remains
# bundled only for explicit legacy snapshot maintenance until that tooling splits.
needed = subprocess.check_output(["patchelf", "--print-needed", str(bundle / "bin/ecx-bridge")], text=True)
if "sqlite" in needed.lower():
    raise ValueError("Production runtime links legacy SQLite")
# Relative RUNPATH makes the maintenance SQLite authoritative without global changes.
for name in ("ecx-bridge", "sqlite3"):
    run("patchelf", "--set-rpath", "$ORIGIN/../lib", str(bundle / "bin" / name))
run("patchelf", "--replace-needed", "libsqlite3.so", "libsqlite3.so.0", str(bundle / "bin/sqlite3"))
run("patchelf", "--set-soname", "libsqlite3.so.0", str(bundle / "lib/libsqlite3.so.0"))
clean_env = dict(os.environ)
clean_env.pop("LD_LIBRARY_PATH", None)
run(str(bundle / "bin/ecx-bridge"), "version", env=clean_env)
run(str(bundle / "bin/sqlite3"), ":memory:", "SELECT sqlite_version();", env=clean_env)
files = {str(p.relative_to(bundle)): hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(bundle.rglob("*")) if p.is_file()}
(bundle / "manifest.json").write_text(json.dumps({"format": 1, "os": "ubuntu-24.04", "arch": arch, "files": files}, indent=2) + "\n")
print(f"Release built and tested: {bundle}")
# Share packaging with deployment-only updates; compiled artifacts stay verified.
import sys
sys.path.insert(0, str(root / "deploy"))
from package_release import package_release
package_release(bundle, cache, arch)
