#!/usr/bin/env python3
"""Collect original license texts from the actual Linux build inputs, offline."""
import argparse
import hashlib
import gzip
import json
from pathlib import Path
import re
import tarfile
import tomllib
import urllib.request
import urllib.error

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("build", type=Path)
parser.add_argument("output", type=Path)
parser.add_argument("--fetch-missing", action="store_true", help="fetch pinned missing archives and notices at crate-recorded upstream commits")
args = parser.parse_args()
root = Path(__file__).resolve().parents[1]
build = args.build.resolve()
args.output.mkdir(parents=True, exist_ok=True)
records = []
sections = []
upstream_errors = []
name_pattern = re.compile(r"^(authors|unlicense|licen[cs]e|copying|copyright|notice)([._-].*)?$", re.I)


def is_notice(name):
    return bool(name_pattern.match(Path(name).name)) or any(p.lower() in ("licenses", "licences") for p in Path(name).parts)


def licenses(entries):
    return [(name, data) for name, data in entries if is_notice(name)]


def archive_entries(path, checksum):
    if hashlib.sha256(path.read_bytes()).hexdigest() != checksum:
        raise ValueError("Source checksum mismatch: " + path.name)
    with tarfile.open(path) as archive:
        # Read only ordinary bounded text candidates; never extract package paths.
        return [(m.name, archive.extractfile(m).read()) for m in archive.getmembers()
                if m.isfile() and m.size <= 2_000_000 and is_notice(m.name)]


def fetch(url, path, checksum):
    with urllib.request.urlopen(url, timeout=60) as response:
        data = response.read(64_000_001)
    if len(data) > 64_000_000 or hashlib.sha256(data).hexdigest() != checksum:
        raise ValueError("Downloaded source does not match the pinned hash")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)


def upstream_crate_notices(archive, name, version):
    """Crates often omit workspace licenses; retain exact-commit provenance separately."""
    prefix = f"{name}-{version}/"
    with tarfile.open(archive) as source:
        metadata = tomllib.loads(source.extractfile(prefix + "Cargo.toml").read().decode())
        try:
            vcs = json.loads(source.extractfile(prefix + ".cargo_vcs_info.json").read())
        except KeyError:
            return []
    repo = metadata["package"].get("repository", "").removesuffix(".git").rstrip("/")
    # The crate retains its old monorepo URL. Its exact commit is preserved here.
    if (name, version, repo) == ("spl-memo-interface", "2.0.0", "https://github.com/solana-labs/solana-program-library"):
        repo = "https://github.com/solana-program/memo"
    commit = vcs.get("git", {}).get("sha1", "")
    if not re.fullmatch(r"https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo) or not re.fullmatch(r"[a-f0-9]{40}", commit):
        return []
    identifier = repo.removeprefix("https://github.com/")
    cache = build / "notice-sources" / (hashlib.sha256((repo + commit).encode()).hexdigest() + ".json")
    if cache.exists():
        return [(x["url"], x["text"].encode()) for x in json.loads(cache.read_text())]
    if not args.fetch_missing:
        return []
    request = urllib.request.Request(f"https://api.github.com/repos/{identifier}/contents?ref={commit}", headers={"Accept": "application/vnd.github+json", "User-Agent": "ecx-bridge-notice-collector"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            entries = json.load(response)
    except urllib.error.HTTPError as error:
        upstream_errors.append(dict(package=f"{name}-{version}", url=request.full_url, status=error.code))
        return []
    result = []
    for entry in entries:
        if entry["type"] == "file" and name_pattern.match(entry["name"]):
            url = f"https://raw.githubusercontent.com/{identifier}/{commit}/{entry['name']}"
            with urllib.request.urlopen(url, timeout=30) as response:
                text = response.read(2_000_001)
            if len(text) > 2_000_000:
                raise ValueError("Upstream notice too large")
            result.append(dict(url=url, text=text.decode("utf-8")))
    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(result))
    return [(x["url"], x["text"].encode()) for x in result]


def add(ecosystem, name, version, source, texts, **extra):
    texts = sorted(set(texts))
    record = dict(ecosystem=ecosystem, name=name, version=version, source=source,
                  status="collected" if texts else "missing", files=[], **extra)
    for filename, data in texts:
        original = data
        if data.startswith(b"\x1f\x8b"):
            data = gzip.decompress(data)
        try:
            content = data.decode("utf-8", errors="strict")
            encoding = "utf-8"
        except UnicodeDecodeError:
            content = data.decode("latin-1")
            encoding = "latin-1"
        record["files"].append(dict(path=filename, sha256=hashlib.sha256(original).hexdigest(), encoding=encoding, gzip=original != data))
        sections.append(f"\n{'=' * 72}\n{ecosystem}: {name} {version}\nSource: {source}\nFile: {filename}\n{'=' * 72}\n\n" + content + "\n")
    records.append(record)


plan = json.loads((build / "dist/cache/plan.json").read_text())
ghc_notices = build / "tools/notices/ghc-source"
if not ghc_notices.is_dir():
    ghc_notices = build / "ghc-source"
seen = set()
for package in plan["install-plan"]:
    name, version = package["pkg-name"], package["pkg-version"]
    if name == "ecx-bridge" or (name, version) in seen:
        continue
    seen.add((name, version))
    if package["type"] == "pre-existing":
        candidates = list(ghc_notices.glob(f"*/share/doc/*/{name}-{version}/**/*"))
        texts = licenses([(str(p.relative_to(ghc_notices)), p.read_bytes()) for p in candidates if p.is_file() and name_pattern.match(p.name)])
        provenance = "Pinned GHC 9.14.1 bindist"
        extra = {}
        if name == "rts" and version == "1.0.3" and not texts:
            url, checksum = json.loads((root / "deploy/toolchains.json").read_text())["ghc-source"]
            archive = build / "notice-sources/ghc-9.14.1-src.tar.xz"
            if not archive.exists() and args.fetch_missing:
                fetch(url, archive, checksum)
            if archive.exists():
                if hashlib.sha256(archive.read_bytes()).hexdigest() != checksum:
                    raise ValueError("GHC source checksum mismatch")
                with tarfile.open(archive) as source:
                    declaration = source.extractfile("ghc-9.14.1/rts/rts.cabal").read()
                    if b"license: BSD-3-Clause" not in declaration:
                        raise ValueError("GHC runtime license declaration changed")
                    texts = [("ghc-9.14.1/LICENSE", source.extractfile("ghc-9.14.1/LICENSE").read())]
                provenance = url
                extra = dict(sourceSha256=checksum, licenseDeclarationSha256=hashlib.sha256(declaration).hexdigest(), noticeLocation="GHC distribution license; runtime declares BSD-3-Clause in rts/rts.cabal")
        add("GHC bundled library", name, version, provenance, texts, **extra)
    else:
        source = build / "cabal/packages/hackage.haskell.org" / name / version / f"{name}-{version}.tar.gz"
        if not source.exists() and args.fetch_missing:
            fetch(f"https://hackage-content.haskell.org/package/{name}-{version}.tar.gz", source, package["pkg-src-sha256"])
        if not source.exists():
            add("Haskell", name, version, "Missing cached source archive", [])
            continue
        texts = archive_entries(source, package["pkg-src-sha256"])
        add("Haskell", name, version, f"https://hackage.haskell.org/package/{name}-{version}", texts, sourceSha256=package["pkg-src-sha256"])

lock = tomllib.loads((root / "solana-helper/Cargo.lock").read_text())
for package in lock["package"]:
    name, version = package["name"], package["version"]
    if name == "ecx-solana-helper":
        continue
    sources = list((build / "cargo/registry/cache").glob(f"*/{name}-{version}.crate"))
    cached = build / "notice-sources" / f"{name}-{version}.crate"
    if not sources and cached.exists():
        sources = [cached]
    if not sources and args.fetch_missing:
        source = build / "notice-sources" / f"{name}-{version}.crate"
        if not source.exists():
            fetch(f"https://static.crates.io/crates/{name}/{name}-{version}.crate", source, package["checksum"])
        sources = [source]
    if len(sources) != 1:
        raise ValueError(f"Missing or ambiguous crate archive: {name}-{version}")
    texts = archive_entries(sources[0], package["checksum"])
    from_upstream = not texts
    if from_upstream:
        texts = upstream_crate_notices(sources[0], name, version)
    add("Rust", name, version, f"https://crates.io/crates/{name}/{version}", texts, sourceSha256=package["checksum"], noticeLocation="repository root at crate-recorded commit; review applicability" if from_upstream else "crate archive")

npm_lock = json.loads((root / "web/package-lock.json").read_text())
omitted = []
for relative, package in npm_lock["packages"].items():
    if not relative:
        continue
    source = root / "web" / relative
    if not source.is_dir():
        if not package.get("optional"):
            raise ValueError("Missing npm package: " + relative)
        omitted.append(relative)
        continue
    metadata = json.loads((source / "package.json").read_text())
    if metadata["version"] != package["version"]:
        raise ValueError("npm version mismatch: " + relative)
    texts = licenses([(str(p.relative_to(source)), p.read_bytes()) for p in source.rglob("*") if p.is_file() and is_notice(p.name)])
    location = "installed package"
    if not texts and metadata["name"].startswith("@esbuild/"):
        parent = root / "web/node_modules/esbuild"
        parent_metadata = json.loads((parent / "package.json").read_text())
        if parent_metadata["version"] != metadata["version"]:
            raise ValueError("esbuild binary/parent version mismatch")
        texts = [("esbuild/LICENSE.md", (parent / "LICENSE.md").read_bytes())]
        location = "same-version parent esbuild package; review applicability"
    add("npm (installed build graph)", metadata["name"], metadata["version"], package["resolved"], texts, integrity=package["integrity"], noticeLocation=location)

# Rust's standard library and GHC's RTS may include licenses beyond package metadata.
for name, directory in (("Rust 1.97.1 distribution", build / "rust-source"), ("GHC 9.14.1 distribution", build / "ghc-source")):
    retained = build / "tools/notices" / directory.name
    if retained.is_dir():
        directory = retained
    texts = []
    for p in directory.glob("*/*"):
        if p.is_file() and name_pattern.match(p.name):
            texts.append((str(p.relative_to(directory)), p.read_bytes()))
    if name.startswith("GHC"):
        for p in directory.glob("*/share/doc/*/ghc-9.14.1/LICENSE"):
            texts.append((str(p.relative_to(directory)), p.read_bytes()))
    add("Toolchain", name, "", "Checksum-pinned upstream bindist", texts)

missing = [f"{r['ecosystem']}: {r['name']} {r['version']}" for r in records if r["status"] == "missing"]
coverage = dict(scope="Actual Linux build plan, complete Cargo lock graph, installed npm graph, bundled toolchain notices. Includes build/test dependencies conservatively; not a legal opinion or completed distribution audit.",
                buildPlanSha256=hashlib.sha256((build / "dist/cache/plan.json").read_bytes()).hexdigest(),
                lockfileSha256={str(p): hashlib.sha256((root / p).read_bytes()).hexdigest() for p in (Path("cabal.project.freeze"), Path("solana-helper/Cargo.lock"), Path("web/package-lock.json"))},
                records=records, absentOptionalNpmPackages=omitted, missing=missing, upstreamFetchErrors=upstream_errors,
                remainingReview=["Bitcoin Core and its bundled third-party notices", "SQLite amalgamation notices", "System libraries supplied by Ubuntu", "License obligations beyond presence of a license text"])
(args.output / "coverage.json").write_text(json.dumps(coverage, indent=2) + "\n")
(args.output / "THIRD_PARTY_NOTICES.txt").write_text("Original upstream license texts for ECX Bridge build dependencies.\nSee coverage.json for source hashes, scope and remaining review.\n" + "".join(sections))
print(json.dumps(dict(packages=len(records), collected=len(records)-len(missing), missing=missing)))
