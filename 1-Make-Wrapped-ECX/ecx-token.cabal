cabal-version: 3.14
name: ecx-token
version: 0.1.0.0
synopsis: Separate ECX token administration through bounded SDK FFI
license: MIT
build-type: Simple

library
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Wcompat
  hs-source-dirs: .
  exposed-modules: Token, Token.Signing, Token.Network, Token.Metadata, Token.Operation
  build-depends: base >=4.20 && <4.23, ecx-bridge, ecx-bridge:chain,
    aeson, bytestring, text, binary, unix, filepath, crypton, ram, base64-bytestring, http-client

test-suite token-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: base, ecx-token, ecx-build-assets, ecx-bridge, ecx-bridge:chain,
    QuickCheck, text, bytestring, aeson, crypton, ram, directory, filepath, unix

executable ecx-token
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, ecx-token, ecx-build-assets, aeson, bytestring, text
