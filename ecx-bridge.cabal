cabal-version: 3.0
name: ecx-bridge
version: 0.1.0.0
synopsis: Inventory bridge for real L2L Signet and ECX networks
description: Development implementation of an inventory bridge with a durable
             ledger, private worker, typed API, and fixed Solana transaction helper.
category: Finance
license: MIT
license-file: LICENSE
build-type: Simple
extra-source-files: migrations/*.sql, migrations/postgresql/*.sql, migrations/postgresql/*.json, config/*.json, web/*.html, web/*.css, docs/*.md,
                    test/fixtures/*.json

common settings
  default-language: GHC2021
  default-extensions: OverloadedStrings, DeriveGeneric, DeriveAnyClass, LambdaCase, RecordWildCards
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
  import: settings
  hs-source-dirs: src
  other-modules: Bridge.Operation.Internal
  exposed-modules: Bridge.Postgres.CoveredSource, Bridge.Postgres.Backup, Bridge.Postgres.LossCover, Bridge.Postgres.Replacement, Bridge.Postgres.NativeRecovery, Bridge.Postgres.NativeFamily, Bridge.Postgres.Cancellation, Bridge.Postgres.Retry, Bridge.Postgres.Maintenance, Bridge.Postgres.Startup, Bridge.Postgres.Refund, Bridge.SolanaPay, Bridge.Operation, Bridge.Postgres.Server, Bridge.Postgres.Runtime, Bridge.Postgres.Settlement, Bridge.Postgres.Preparation, Bridge.Postgres.Reconciliation, Bridge.Postgres.PaymentStore, Bridge.Postgres.Custody, Bridge.Postgres.Observer, Bridge.Postgres.Source, Bridge.Postgres.Observation, Bridge.Postgres.Provisioning, Bridge.Postgres.Order, Bridge.Postgres.Budget, Bridge.Postgres.Ledger, Bridge.Postgres.Schema, Bridge.Types, Bridge.Config, Bridge.Budget, Bridge.Ledger, Bridge.Reconciliation, Bridge.Recovery, Bridge.Reorg, Bridge.RPC, Bridge.Native, Bridge.NativePayment, Bridge.NativeReplacement, Bridge.Payment, Bridge.Settlement, Bridge.Deposit, Bridge.Order, Bridge.Admission, Bridge.Solana, Bridge.SolanaHelper, Bridge.SolanaPayment, Bridge.SolanaMessage, Bridge.SolanaDeposit, Bridge.Observer, Bridge.Process, Bridge.Backup, Bridge.API, Bridge.Web, Bridge.Worker
  build-depends:
    base >=4.20 && <4.23, aeson >=2.2 && <2.4, async >=2.2 && <2.3,
    base16-bytestring >=1 && <1.1, base58-bytestring >=0.1 && <0.2,
    base64-bytestring >=1.2 && <1.3, binary >=0.8 && <0.9,
    bytestring >=0.11 && <0.13, containers >=0.6 && <0.9,
    crypton >=1 && <1.2, directory >=1.3 && <1.4, filepath >=1.4 && <1.6,
    file-embed >=0.0.16 && <0.1, filelock >=0.1 && <0.2, http-client >=0.7 && <0.8,
    http-client-tls >=0.4 && <0.5, http-types >=0.12 && <0.13,
    ram >=0.22 && <0.23, network >=3.1 && <3.3,
    process >=1.6 && <1.7, scientific >=0.3 && <0.4,
    servant >=0.20 && <0.21, servant-server >=0.20 && <0.21,
    product-profunctors >=0.11 && <0.12,
    opaleye ==0.10.8.0, postgresql-simple >=0.7 && <0.8,
    servant-client >=0.20 && <0.21, sqlite-simple >=0.4.19 && <0.5,
    transformers >=0.6 && <0.7, stm >=2.5 && <2.6, text >=2.1 && <2.2, time >=1.12 && <1.16,
    unix >=2.8 && <2.9, wai >=3.2 && <3.3, wai-extra >=3.1 && <3.2,
    warp >=3.3 && <3.5

executable ecx-bridge
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  build-depends: base, ecx-bridge, postgresql-simple, unix, aeson, bytestring, text

test-suite bridge-test
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  ghc-options: -threaded
  build-depends: base, ecx-bridge, aeson, bytestring, directory, filepath,
    hspec >=2.11 && <2.12, QuickCheck >=2.15 && <2.19, sqlite-simple,
    text, time, async, network, http-client, servant-client, servant, unix, scientific, base64-bytestring,
    crypton, ram

-- Real integration seam for the PostgreSQL/DSL migration, private Unix API only.
executable ecx-postgres-seam
  import: settings
  hs-source-dirs: integration
  main-is: Main.hs
  ghc-options: -threaded
  build-depends: base, ecx-bridge, text, servant, servant-server,
    postgresql-simple, opaleye

executable ecx-postgres-journal-check
  import: settings
  hs-source-dirs: integration
  main-is: JournalCheck.hs
  build-depends: base, ecx-bridge, containers, postgresql-simple, unix, text

executable ecx-postgres-scan-check
  import: settings
  hs-source-dirs: integration
  main-is: ScanCheck.hs
  build-depends: base, ecx-bridge, aeson, bytestring, postgresql-simple, unix, text, opaleye

-- Fault-injected real-network acceptance; never bundled in the server release.
executable ecx-postgres-native-lock-check
  import: settings
  hs-source-dirs: integration
  main-is: NativeLockCheck.hs
  build-depends: base, ecx-bridge, aeson, bytestring, postgresql-simple, unix, text

executable ecx-postgres-source-approval-check
  import: settings
  hs-source-dirs: integration
  main-is: SourceApprovalCheck.hs
  build-depends: base, ecx-bridge, aeson, bytestring, postgresql-simple, unix, text

-- Certificate-only validation; never included in the server release bundle.
executable ecx-tls-constraints-check
  import: settings
  hs-source-dirs: integration
  main-is: TLSConstraintsCheck.hs
  build-depends: base, bytestring, filepath, data-default,
    crypton-pem, crypton-x509, crypton-x509-store, crypton-x509-validation
