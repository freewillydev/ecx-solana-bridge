cabal-version: 3.14
name: ecx-bridge-rebuild
version: 0.1.0.0
synopsis: Replacement ECX bridge with explicit payment funding
license: MIT
build-type: Simple
data-files: test/fixtures/*.json

common settings
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
  import: settings
  hs-source-dirs: src
  exposed-modules: Bridge.Domain, Bridge.Error, Bridge.Identity, Bridge.Wire, Bridge.Operation, Bridge.Operation.Internal
  build-depends: base >=4.20 && <4.23, aeson >=2.2 && <2.4, text >=2.1 && <2.2, containers, bytestring, base16-bytestring, base58-bytestring, crypton >=1 && <1.2, ram >=0.22 && <0.23

library customer-api
  import: settings
  visibility: private
  hs-source-dirs: api
  exposed-modules: Bridge.API
  build-depends: base, ecx-bridge-rebuild, text,
    servant >=0.20 && <0.21, servant-server >=0.20 && <0.21
  mixins: ecx-bridge-rebuild hiding (Bridge.Operation.Internal)

library store
  import: settings
  visibility: private
  hs-source-dirs: runtime
  exposed-modules: Bridge.Store
  other-modules: Bridge.Store.Schema, Bridge.Store.Catalog
  build-depends: base, ecx-bridge-rebuild, aeson, bytestring, text, containers,
    crypton, time, scientific, opaleye ==0.10.8.0, postgresql-simple >=0.7 && <0.8,
    product-profunctors >=0.11 && <0.12

library chain
  import: settings
  visibility: private
  hs-source-dirs: chain
  exposed-modules: Bridge.RPC, Bridge.Native, Bridge.NativePayment, Bridge.Solana, Bridge.SolanaMessage, Bridge.SolanaHelper, Bridge.SolanaPayment
  build-depends: base, ecx-bridge-rebuild, aeson, bytestring, text, scientific,
    filepath, http-client, http-client-tls, http-types, binary, base58-bytestring,
    base64-bytestring, crypton, unix

test-suite rebuild-test
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: ChainCheck, NativePaymentCheck, SolanaPaymentCheck, Paths_ecx_bridge_rebuild
  autogen-modules: Paths_ecx_bridge_rebuild
  build-depends: base, ecx-bridge-rebuild, ecx-bridge-rebuild:customer-api, ecx-bridge-rebuild:chain, servant, aeson, text, containers,
    QuickCheck >=2.15 && <2.19, bytestring, scientific, http-client, base64-bytestring

-- Explicitly invoked against a disposable migrated database, never live custody.
executable rebuild-store-check
  import: settings
  hs-source-dirs: test, runtime
  main-is: StoreCheck.hs
  other-modules: Bridge.Store, Bridge.Store.Schema, Bridge.Store.Catalog
  build-depends: base, ecx-bridge-rebuild, aeson, bytestring,
    containers, text, crypton, time, scientific, opaleye, postgresql-simple, product-profunctors, QuickCheck
