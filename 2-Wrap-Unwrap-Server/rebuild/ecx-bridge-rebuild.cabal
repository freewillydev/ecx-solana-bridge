cabal-version: 3.14
name: ecx-bridge-rebuild
version: 0.1.0.0
synopsis: Replacement ECX bridge with explicit payment funding
license: MIT
build-type: Simple

common settings
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
  import: settings
  hs-source-dirs: src
  exposed-modules: Bridge.Domain, Bridge.Wire, Bridge.Operation, Bridge.Operation.Internal
  build-depends: base >=4.20 && <4.23, aeson >=2.2 && <2.4, text >=2.1 && <2.2, containers

library customer-api
  import: settings
  visibility: private
  hs-source-dirs: api
  exposed-modules: Bridge.API
  build-depends: base, ecx-bridge-rebuild, text,
    servant >=0.20 && <0.21, servant-server >=0.20 && <0.21
  mixins: ecx-bridge-rebuild hiding (Bridge.Operation.Internal)

test-suite rebuild-test
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: base, ecx-bridge-rebuild, ecx-bridge-rebuild:customer-api, servant, aeson, text, containers,
    QuickCheck >=2.15 && <2.19
