[Unit]
Description=Consistent private ECX bridge ledger backup
After=ecx-bridge-postgres.service
Requires=ecx-bridge-postgres.service

[Service]
Type=oneshot
User=ecx-worker
Group=ecx-worker
EnvironmentFile=/etc/ecx-bridge/postgres.env
ExecStart=/usr/bin/python3 /opt/ecx-bridge/current/deploy/postgres-backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecx-bridge/private
RestrictAddressFamilies=AF_UNIX
