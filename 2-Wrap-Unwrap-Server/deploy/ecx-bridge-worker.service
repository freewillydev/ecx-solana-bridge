[Unit]
Description=ECX bridge HTTP API and payment workflows
After=network-online.target ecx-bridge-node.service ecx-bridge-postgres.service ecx-bridge-signer.service
Requires=ecx-bridge-postgres.service
Wants=network-online.target

[Service]
Type=simple
User=ecx-worker
Group=ecx-api
SupplementaryGroups=ecx-worker
UMask=0077
Environment=ECX_PORT=8080
Environment=ECX_ASSETS=/opt/ecx-bridge/current/web
EnvironmentFile=-/etc/ecx-bridge/web.env
EnvironmentFile=/etc/ecx-bridge/postgres.env
EnvironmentFile=-/etc/ecx-bridge/interface.env
EnvironmentFile=-/etc/ecx-bridge/fence.env
ExecStart=/opt/ecx-bridge/current/bin/ecx-bridge postgres-api /etc/ecx-bridge/worker.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=ecx-bridge
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecx-bridge/private /var/lib/ecx-bridge/fence /run/ecx-bridge
InaccessiblePaths=-/run/ecx-node -/var/lib/ecx-node -/etc/ecx-bridge/signing -/etc/ecx-bridge/signer.json -/etc/ecx-bridge/signing.auth.key
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
LimitNOFILE=1024
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
