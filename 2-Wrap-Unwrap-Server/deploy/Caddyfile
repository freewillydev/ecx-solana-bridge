# Supply BRIDGE_HOST through Caddy's root-controlled environment.
{$BRIDGE_HOST} {
    encode zstd gzip
    request_body {
        max_size 16KB
    }
    reverse_proxy 127.0.0.1:8080
    header {
        Strict-Transport-Security "max-age=31536000"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
}
