#!/usr/bin/env python3
"""Read canonical Jupiter quotes in both directions; never sign or execute."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import sys
import urllib.request
from urllib.parse import urlencode

USDC = 'EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v'
WRAPPED = 'EVHqNdzjCupKi4rQkbuYw52sa1m8A7jeUAMP23S9AVVq'
POOL = 'nNKg814Wq3uTkoG4fM8LzvBQv4Fu2iCgKFmK2YmPQzM'
ENDPOINT = 'https://api.jup.ag/swap/v2/order'


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise ValueError('Unexpected API redirect')


def quantity(value):
    if not isinstance(value, str) or not re.fullmatch('[1-9][0-9]{0,19}', value) or int(value) > 2**64-1:
        raise ValueError('Invalid positive base-unit amount')
    return value


def quote(opener, source, destination, amount, headers):
    # Omitting taker requests pricing only, without a customer identity or an
    # assembled transaction. This utility has no execute or RPC send path.
    url = ENDPOINT + '?' + urlencode(dict(inputMint=source, outputMint=destination, amount=amount))
    with opener.open(urllib.request.Request(url, headers=headers), timeout=25) as response:
        raw = response.read(1024 * 1024 + 1)
        if response.status != 200 or len(raw) > 1024 * 1024:
            raise ValueError('Quote response refused')
    data = json.loads(raw)
    if data.get('inputMint') != source or data.get('outputMint') != destination or data.get('inAmount') != amount:
        raise ValueError('Quote identity mismatch')
    if data.get('transaction') not in (None, '') or data.get('taker') is not None or data.get('errorCode') is not None:
        raise ValueError('Not a successful identity-free quote')
    quantity(data['outAmount'])
    route = data['routePlan']
    if not isinstance(route, list) or len(route) != 1:
        raise ValueError('Published direct pool route required')
    leg = route[0]
    info = leg['swapInfo']
    if (info.get('ammKey'), info.get('inputMint'), info.get('outputMint')) != (POOL, source, destination):
        raise ValueError('Published pool binding mismatch')
    if leg.get('bps') != 10000 or data.get('swapMode') != 'ExactIn':
        raise ValueError('Full direct exact-input route required')
    return dict(inputMint=source, outputMint=destination, inputBaseUnits=amount,
                quotedOutputBaseUnits=data['outAmount'], router=data.get('router'),
                pool=POOL, poolLabel=info.get('label'), routeBasisPoints=10000,
                aggregatorFeeBasisPoints=data.get('feeBps'),
                observedAt=datetime.now(timezone.utc).isoformat(),
                responseSha256=hashlib.sha256(raw).hexdigest())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--report', required=True, type=Path)
    parser.add_argument('--usdc-base-units', default='1000000', type=quantity)
    parser.add_argument('--wrapped-base-units', default='100000000', type=quantity)
    args = parser.parse_args()
    opener = urllib.request.build_opener(NoRedirect())
    readings = [quote(opener, USDC, WRAPPED, args.usdc_base_units, {}),
                quote(opener, WRAPPED, USDC, args.wrapped_base_units, {})]
    report = dict(endpoint=ENDPOINT, network='Solana mainnet-beta',
                  quoteOnly=True, walletIdentityProvided=False,
                  signedOrSent=False, executedTradeVerified=False,
                  issuerApprovalVerified=False, reserveBackingVerified=False,
                  canonicalActivationAuthorized=False, readings=readings)
    args.report.write_text(json.dumps(report, indent=2) + '\n')
    print('Verified both quoted directions through the published pool; no trade executed')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, TypeError, OSError):
        sys.exit('Market quote verification refused; investigate API availability or route identity')
