#!/usr/bin/env python3
"""Inventory loaded libraries and installed Ubuntu notices for a verified release.

Read-only application inspection. ldd executes the loader only for the fixed,
manifest-verified installed binaries. No wallet, ledger or network access.
This records notice provenance; it does not decide license obligations.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import subprocess
import sys

sys.dont_write_bytecode = True
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('release', type=Path)
parser.add_argument('output', type=Path)
args = parser.parse_args()
release = args.release.resolve(strict=True)
sys.path.insert(0, str(release / 'deploy'))
from install import verify
identity = verify(release)
assert platform.system() == 'Linux'
assert not args.output.exists(), 'Choose a new inventory directory'
env = {k: v for k, v in os.environ.items() if not k.startswith('LD_')}
env['LC_ALL'] = 'C'

def run(*command):
    return subprocess.check_output(command, env=env, text=True, timeout=30)

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

binaries = {}
libraries = {}
for name in ('ecx-bridge', 'ecx-solana-helper', 'bitcoind', 'bitcoin-cli'):
    binary = release / 'bin' / name
    loaded = []
    listing = run('ldd', str(binary))
    assert 'not found' not in listing, 'Unresolved installed library'
    for line in listing.splitlines():
        match = re.search(r'(?:=>\s*)?(/[^\s]+)\s+\(0x[0-9a-f]+\)', line)
        if not match:
            assert not line.strip() or 'linux-vdso' in line, 'Unexpected loader output'
            continue
        path = Path(match.group(1)).resolve(strict=True)
        loaded.append(str(path))
        libraries[str(path)] = path
    binaries[name] = dict(sha256=digest(binary), libraries=sorted(set(loaded)))

records = []
notices = {}
for location, path in sorted(libraries.items()):
    record = dict(path=location, sha256=digest(path))
    if path.is_relative_to(release):
        record.update(origin='bundle', manifestPath=str(path.relative_to(release)))
    else:
        candidates = [location]
        if location.startswith('/usr/lib/'):
            candidates.append(location[4:])
        owners = []
        for candidate in candidates:
            result = subprocess.run(['dpkg-query', '-S', candidate], env=env,
                capture_output=True, text=True, timeout=10)
            if result.returncode == 0:
                owners = sorted({line.rsplit(': ', 1)[0] for line in result.stdout.splitlines()})
                break
        assert len(owners) == 1, 'Installed library ownership is ambiguous'
        package = owners[0]
        version = run('dpkg-query', '-W', '-f=${Version}', package).strip()
        notice = Path('/usr/share/doc') / package.split(':')[0] / 'copyright'
        assert notice.is_file(), 'Installed package copyright notice missing'
        record.update(origin='ubuntu', package=package, version=version,
                      noticePath=str(notice), noticeSha256=digest(notice))
        notices[package] = notice.read_bytes()
    records.append(record)

args.output.mkdir(parents=True)
for package, content in notices.items():
    (args.output / (package.replace(':', '_') + '.copyright')).write_bytes(content)
report = dict(format=1, release=identity, arch=platform.machine(), binaries=binaries,
              libraries=records, installedCopyrightNotices=len(notices),
              licenseObligationsReviewed=False, networkAccess=False)
(args.output / 'inventory.json').write_text(json.dumps(report, indent=2) + '\n')
print(json.dumps(dict(release=identity, binaries=len(binaries),
    libraries=len(records), installedCopyrightNotices=len(notices),
    licenseObligationsReviewed=False)))
