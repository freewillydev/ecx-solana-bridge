#!/usr/bin/env python3
"""Update only deployment tooling in a verified compiled bundle, without recompiling."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import sys

root = Path(__file__).resolve().parents[1]
sys.dont_write_bytecode = True
sys.path.insert(0, str(root / "deploy"))
from install import verify
from package_release import package_release

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("bundle", type=Path)
parser.add_argument("output", type=Path)
args = parser.parse_args()
if os.geteuid() == 0 or platform.system() != "Linux":
    parser.error("Run as an unprivileged Linux release builder")
verify(args.bundle)
old = json.loads((args.bundle / "manifest.json").read_text())
args.output.mkdir(parents=True, exist_ok=True)
bundle = args.output / "bundle"
if bundle.exists():
    raise ValueError("Choose a fresh output directory; never overwrite a release")
shutil.copytree(args.bundle, bundle)
shutil.copytree(root / "deploy", bundle / "deploy", dirs_exist_ok=True, ignore=shutil.ignore_patterns("__pycache__"))
files = {str(p.relative_to(bundle)): hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(bundle.rglob("*")) if p.is_file() and p != bundle / "manifest.json"}
for name, digest in old["files"].items():
    if not name.startswith("deploy/") and files.get(name) != digest:
        raise ValueError("Non-deployment artifact changed: " + name)
manifest = dict(old, files=files)
(bundle / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
identity = verify(bundle)
package_release(bundle, args.output, platform.machine())
print("Deployment-only release:", identity, "(all non-deployment artifacts unchanged)")
