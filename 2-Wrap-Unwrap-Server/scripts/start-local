#!/usr/bin/env python3
"""Run the public Signet/Devnet bridge locally. Ctrl-C stops the server."""
import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("config", type=Path)
parser.add_argument("--binary", default=os.environ.get("ECX_BRIDGE_BINARY", "ecx-bridge"))
parser.add_argument("--port", type=int, default=61734)
parser.add_argument("--postgres", action="store_true", default=True, help="Compatibility flag; this launcher always uses PostgreSQL via PG* settings")
args = parser.parse_args()
binary = shutil.which(args.binary)
if not binary:
    parser.error("Build ecx-bridge first, then supply --binary /absolute/path/to/ecx-bridge")
config_path = args.config.resolve(strict=True)
config = json.loads(config_path.read_text())
if config.get("profile") not in {"L2LSignetDevnet", "ECXBetanetDevnet"} or config.get("backupRequired"):
    parser.error("This launcher accepts real Signet-or-betanet / Solana Devnet profiles without required backups")
if not 1024 <= args.port <= 65535:
    parser.error("Use a port from 1024 through 65535")
if args.postgres and not os.environ.get("PGDATABASE"):
    parser.error("--postgres requires PGDATABASE; set private PostgreSQL PG* connection settings")
if args.postgres:
    # All local PostgreSQL paying deployments for this OS account share one
    # custody fence, including clones using different database/config paths.
    fence = Path(os.environ.setdefault("ECX_WORKER_FENCE_DIR", str(Path.home() / ".local/state/ecx-bridge/worker-fence")))
    if not (fence / "sequence.json").exists():
        subprocess.run([binary, "postgres-init-worker-fence", str(config_path)], check=True)
os.environ["ECX_PORT"] = str(args.port)
# The Cabal-built executable defaults to its generated browser assets.
# ECX_ASSETS may explicitly select a deployed bundle.


def stop(_signal=None, _frame=None):
    raise KeyboardInterrupt


signal.signal(signal.SIGTERM, stop)
child = None
try:
    child = subprocess.Popen([binary, "postgres-test-worker", str(config_path)])
    print(f"Bridge: http://127.0.0.1:{args.port} — public test funds only. Ctrl-C to stop.", flush=True)
    raise SystemExit(child.wait())
except KeyboardInterrupt:
    pass
finally:
    if child is not None and child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=10)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
