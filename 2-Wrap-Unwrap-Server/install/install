#!/bin/sh
# Run only from an authenticated release or explicitly trusted local-build snapshot.
# Guard chains intentionally fail if any check fails.
# shellcheck disable=SC2015
set -eu
umask 077
fail() { echo "Installation refused: $*" >&2; exit 1; }
absent() { [ ! -e "$1" ] && [ ! -L "$1" ]; }
[ "$(id -u)" = 0 ] || fail 'root required'
[ "$(uname -s)" = Linux ] || fail 'Ubuntu 24.04 required'
# shellcheck source=/dev/null
. /etc/os-release
[ "$ID:$VERSION_ID" = ubuntu:24.04 ] || fail 'Ubuntu 24.04 required'
mode=${1:-}; material=${2:-}
case "$mode" in fresh) [ "$#" = 2 ] || fail 'fresh requires a private material directory';;
  upgrade) [ "$#" = 1 ] || fail 'upgrade takes no material; existing custody is retained';;
  *) fail 'usage: fresh PRIVATE_MATERIAL_DIRECTORY | upgrade';;
esac
bundle=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
[ "$(cat "$bundle/architecture")" = "$(uname -m)" ] || fail 'wrong architecture'
(cd "$bundle" && sha256sum -c manifest.sha256 >/dev/null) || fail 'bundle changed'
release=$(sha256sum "$bundle/manifest.sha256" | cut -d' ' -f1)
prefix=/opt/ecx-bridge
config=/etc/ecx-bridge
state=/var/lib/ecx-bridge
worker=ecxbridgew
signer=ecxbridges
reader=ecxbridger
journal=/var/lib/ecx-bridge-install
exec 9>/run/lock/ecx-bridge-install.lock
flock -n 9 || fail 'another installation is running'
resuming=false
if [ -e "$journal" ] || [ -L "$journal" ]; then
  [ -d "$journal" ] && [ ! -L "$journal" ] && [ "$(stat -c '%u:%a' "$journal")" = 0:700 ] || fail 'unsafe installation journal'
  resuming=true
fi
if [ "$mode" = fresh ]; then
  case "$material" in /*) ;; *) fail 'material directory must be absolute';; esac
  [ -d "$material" ] && [ ! -L "$material" ] || fail 'material directory required'
  material=$(realpath -e -- "$material")
  parent=$material
  while :; do
    [ "$(stat -c %u "$parent")" = 0 ] || fail 'material ancestors must be root-owned'
    permissions=$(stat -c %a "$parent")
    [ "$((0$permissions & 022))" = 0 ] || fail 'material ancestors must not be group/other writable'
    [ "$parent" != / ] || break
    parent=$(dirname -- "$parent")
  done
  if [ "$resuming" = false ]; then
    absent "$config" && absent "$state" && absent "$prefix" || fail 'existing deployment: use upgrade or explicit recovery'
    for account in "$worker" "$signer"; do
      ! getent passwd "$account" >/dev/null && ! getent group "$account" >/dev/null || fail 'service identities already exist'
    done
  fi
else
  [ -f "$config/installed" ] && [ -L "$prefix/current" ] || fail 'no completed installation'
  cmp "$bundle/migrations.sha256" "$prefix/current/migrations.sha256" >/dev/null || fail 'schema change requires reviewed offline migration before upgrade'
fi
# No source compilation or unpinned application download occurs under root.
export DEBIAN_FRONTEND=noninteractive
packages='postgresql-16 postgresql-client-16 libpq5 libgmp10 libffi8 zlib1g libssl3t64 ca-certificates openssl jq'
missing=false
for package in $packages; do
  [ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" = 'install ok installed' ] || missing=true
done
if [ "$missing" = true ]; then
  apt-get update -qq
  # Fixed package names, deliberately split.
  # shellcheck disable=SC2086
  apt-get install -y --no-install-recommends $packages
fi
if [ "$mode" = fresh ]; then
  # Inputs are data, never sourced shell. Refuse symlinks and exposed material.
  [ "$(stat -c '%u:%a' "$material")" = 0:700 ] || fail 'material must be root-owned mode 0700'
  # Resolve only the closed list below. Legacy manually prepared bundles still work.
  source_file() {
    if [ -f "$material/sources.json" ]; then
      jq -er --arg name "$1" '.[$name] | select(type == "string" and startswith("/") and (contains("\n") | not) and (contains("\r") | not))' "$material/sources.json"
    else
      printf '%s/%s\n' "$material" "$1"
    fi
  }
  private_source() {
    [ -f "$1" ] && [ ! -L "$1" ] && [ "$(stat -c '%u:%a' "$1")" = 0:600 ] || fail 'source must be root-owned regular mode 0600'
    parent=$(dirname -- "$1")
    [ -d "$parent" ] && [ ! -L "$parent" ] && [ "$(stat -c '%u:%a' "$parent")" = 0:700 ] || fail 'source directory must be root-owned mode 0700'
  }
  for name in worker.json signer.json; do private_source "$material/$name"; done
  if [ -e "$material/sources.json" ] || [ -L "$material/sources.json" ]; then
    private_source "$material/sources.json"
    jq -e 'type == "object" and all(to_entries[]; (.key as $k | ["solana.keypair.json","native-worker.auth","native-signer.auth","native-unlock","backup.repository","backup.password","public-fullchain.pem","public-privkey.pem"] | index($k)) != null and (.value | type == "string" and startswith("/") and (explode | all(. >= 32 and . != 127))))' "$material/sources.json" >/dev/null || fail 'invalid source references'
  fi
  key_source=$(source_file solana.keypair.json) || fail 'missing key source'
  worker_source=$(source_file native-worker.auth) || fail 'missing worker credential source'
  signer_source=$(source_file native-signer.auth) || fail 'missing signer credential source'
  for source in "$key_source" "$worker_source" "$signer_source"; do private_source "$source"; done
  unlock_source=$(source_file native-unlock 2>/dev/null) || unlock_source=
  cert_source=$(source_file public-fullchain.pem 2>/dev/null) || cert_source=
  tls_source=$(source_file public-privkey.pem 2>/dev/null) || tls_source=
  for source in "$unlock_source" "$cert_source" "$tls_source"; do
    if [ -n "$source" ]; then
      if [ -f "$material/sources.json" ] || [ -e "$source" ] || [ -L "$source" ]; then private_source "$source"; fi
    fi
  done
  if [ -e "$cert_source" ] || [ -e "$tls_source" ]; then
    [ -f "$cert_source" ] && [ -f "$tls_source" ] || fail 'both public TLS files required'
  fi
  if [ -e "$material/interface.json" ]; then private_source "$material/interface.json"; fi
  # Validate supplied identity/key/policy before creating accounts or databases.
  "$bundle/bin/ecx-bridge" check-config "$material/worker.json" >/dev/null
  "$bundle/bin/ecx-bridge" check-signer "$material/signer.json" "$key_source" >/dev/null
  [ "$(jq -Sc 'del(.nativeCookie,.nativeUnlockFile,.signerAuthFile)' "$material/worker.json")" = "$(jq -Sc 'del(.nativeCookie,.nativeUnlockFile,.signerAuthFile)' "$material/signer.json")" ] || fail 'worker/signer policies differ'
  ! cmp -s "$worker_source" "$signer_source" || fail 'worker needs distinct restricted native credentials'
  if [ "$(jq -r .backupRequired "$material/worker.json")" = true ]; then
    for name in backup.repository backup.password; do
      source=$(source_file "$name") || fail "missing $name reference"
      private_source "$source"
    done
  fi
  identity_file=$(mktemp /run/ecx-install-material-XXXXXXXX)
  {
    printf '%s\n%s\n' "$release" "$material"
    for name in worker.json signer.json sources.json interface.json; do
      if [ -f "$material/$name" ]; then sha256sum "$material/$name"; fi
    done
    for source in "$key_source" "$worker_source" "$signer_source" "$unlock_source" "$cert_source" "$tls_source"; do
      if [ -n "$source" ] && [ -f "$source" ]; then sha256sum "$source"; fi
    done
    for name in backup.repository backup.password; do
      source=$(source_file "$name" 2>/dev/null) || source=
      if [ -n "$source" ] && [ -f "$source" ]; then private_source "$source"; sha256sum "$source"; fi
    done
  } > "$identity_file"
  identity=$(sha256sum "$identity_file" | cut -d' ' -f1)
  rm "$identity_file"
  if [ "$resuming" = true ]; then
    [ -f "$journal/identity" ] && [ ! -L "$journal/identity" ] && [ "$(cat "$journal/identity")" = "$identity" ] || fail 'installation inputs changed; restore original inputs before retry'
  else
    pending=$(mktemp -d /var/lib/.ecx-bridge-install-XXXXXXXX)
    printf '%s\n' "$identity" > "$pending/identity"
    openssl rand -hex 16 > "$pending/owner"
    sync -f "$pending"
    mv -T "$pending" "$journal"
    sync -f /var/lib
  fi
  if [ -f "$config/installed" ]; then
    [ "$(cat "$config/installed")" = "$release" ] || fail 'installed release differs; use explicit upgrade'
    echo 'This exact installation is already complete.'
    exit 0
  fi
fi
install -d -m 0755 "$prefix" "$prefix/releases"
target=$prefix/releases/$release
if [ ! -e "$target" ]; then
  staging=$(mktemp -d "$prefix/releases/.install-XXXXXXXX")
  trap 'rm -rf -- "${staging:-}"' EXIT
  trap 'exit 1' HUP INT TERM
  cp -R "$bundle/." "$staging/"
  chown -R root:root "$staging"
  chmod -R go-w "$staging"
  chmod 0755 "$staging" "$staging/bin" "$staging/lib" "$staging/share" "$staging/share/web" "$staging/share/web/dist" "$staging/share/migrations"
  chmod 0755 "$staging/bin/"* "$staging/lib/"*
  find "$staging/share" -type f -exec chmod 0644 '{}' +
  (cd "$staging" && sha256sum -c manifest.sha256 >/dev/null)
  mv "$staging" "$target"
  staging=
fi
(cd "$target" && sha256sum -c manifest.sha256 >/dev/null) || fail 'installed release changed'
"$target/bin/restic" version | grep -q '^restic 0.19.1 ' || fail 'tested restic 0.19.1 required'
if [ "$mode" = fresh ]; then
  if [ ! -f "$journal/configured.sha256" ]; then
  for role in worker signer; do
    if [ "$role" = worker ]; then account=$worker; else account=$signer; fi
    getent group "$account" >/dev/null || groupadd --system "$account"
    getent passwd "$account" >/dev/null || useradd --system --gid "$account" --home-dir "$state/$role" --shell /usr/sbin/nologin "$account"
    [ "$(getent passwd "$account" | cut -d: -f1,6,7)" = "$account:$state/$role:/usr/sbin/nologin" ] || fail 'service account changed'
    [ "$(id -Gn "$account")" = "$account" ] || fail 'unexpected service group membership'
  done
  install -d -m 0755 "$config" "$state"
  for role in worker signer; do
    if [ "$role" = worker ]; then account=$worker; else account=$signer; fi
    install -d -m 0750 -o root -g "$account" "$config/$role"
    install -d -m 0700 -o "$account" -g "$account" "$state/$role"
    jq --arg root "$config/$role" --arg sdk "$prefix/current/lib/libecx_solana_sdk.so" --arg fence "$state/worker/fence" \
      '.nativeCookie=($root+"/native.auth") | .signerAuthFile=($root+"/signer.auth") | .solanaSdkLibrary=$sdk | .fenceDirectory=$fence | .nativeUnlockFile=null' \
      "$material/$role.json" > "$config/$role/config.json"
    chown root:"$account" "$config/$role/config.json"
    chmod 0640 "$config/$role/config.json"
    if [ "$role" = worker ]; then credential_source=$worker_source; else credential_source=$signer_source; fi
    install -o "$account" -g "$account" -m 0600 "$credential_source" "$config/$role/native.auth"
  done
  install -o "$signer" -g "$signer" -m 0600 "$key_source" "$config/signer/solana.keypair.json"
  if [ -e "$unlock_source" ]; then
    [ -f "$unlock_source" ] && [ ! -L "$unlock_source" ] && [ "$(stat -c '%u:%a' "$unlock_source")" = 0:600 ] || fail 'protect native-unlock as root:0600'
    install -o "$signer" -g "$signer" -m 0600 "$unlock_source" "$config/signer/native-unlock"
    jq --arg path "$config/signer/native-unlock" '.nativeUnlockFile=$path' "$config/signer/config.json" > "$config/signer/config.new"
    chown root:"$signer" "$config/signer/config.new"; chmod 0640 "$config/signer/config.new"
    mv "$config/signer/config.new" "$config/signer/config.json"
  fi
  if [ -f "$material/interface.json" ]; then
    install -o root -g "$worker" -m 0640 "$material/interface.json" "$config/worker/interface.json"
  fi
  if [ -f "$cert_source" ]; then
    install -o root -g "$worker" -m 0640 "$cert_source" "$config/worker/public-fullchain.pem"
    install -o "$worker" -g "$worker" -m 0600 "$tls_source" "$config/worker/public-privkey.pem"
  fi
  if [ ! -f "$config/signer/signer.auth" ]; then
    openssl rand -hex 32 | tr -d '\n' > "$config/signer/signer.auth.pending"
    mv "$config/signer/signer.auth.pending" "$config/signer/signer.auth"
  fi
  if [ ! -f "$config/signer/signer.auth.pem" ]; then
    openssl req -x509 -newkey ed25519 -nodes -keyout "$config/signer/signer.auth.key.pending" -out "$config/signer/signer.auth.pem.pending" -days 365 \
      -subj /CN=127.0.0.1 -addext subjectAltName=IP:127.0.0.1 >/dev/null 2>&1
    mv "$config/signer/signer.auth.key.pending" "$config/signer/signer.auth.key"
    mv "$config/signer/signer.auth.pem.pending" "$config/signer/signer.auth.pem"
  fi
  for name in signer.auth signer.auth.pem; do
    install -o root -g "$worker" -m 0640 "$config/signer/$name" "$config/worker/$name"
  done
  chown "$signer:$signer" "$config/signer/signer.auth" "$config/signer/signer.auth.key" "$config/signer/signer.auth.pem"
  chmod 0600 "$config/signer/signer.auth" "$config/signer/signer.auth.key" "$config/signer/signer.auth.pem"
  backup=$(jq -r .backupRequired "$config/signer/config.json")
  [ "$backup" = "$(jq -r .backupRequired "$config/worker/config.json")" ] || fail 'backup policies differ'
  if [ "$backup" = true ]; then
    for name in backup.repository backup.password; do
      backup_source=$(source_file "$name") || fail "missing $name reference"
      private_source "$backup_source"
      install -o "$signer" -g "$signer" -m 0600 "$backup_source" "$config/signer/$name"
    done
    jq -n --arg restic "$prefix/current/bin/restic" --arg repositoryFile "$config/signer/backup.repository" --arg passwordFile "$config/signer/backup.password" \
      '{restic:$restic,repositoryFile:$repositoryFile,passwordFile:$passwordFile}' > "$config/signer/backup.json"
    chown "$signer:$signer" "$config/signer/backup.json"; chmod 0600 "$config/signer/backup.json"
  fi
  # Both configurations must describe exactly the same deployment and transport.
  first=$("$target/bin/ecx-bridge" check-config "$config/worker/config.json")
  [ "$first" = "$("$target/bin/ecx-bridge" check-config "$config/signer/config.json")" ] || fail 'deployment identities differ'
  for field in serverPort signerPort; do
    [ "$(jq -r .$field "$config/worker/config.json")" = "$(jq -r .$field "$config/signer/config.json")" ] || fail 'service ports differ'
  done
  runuser -u "$signer" -- "$target/bin/ecx-bridge" check-signer "$config/signer/config.json" "$config/signer/solana.keypair.json"
  [ -z "$(find "$config" -type l -print)" ] || fail 'unexpected configuration symlink'
  find "$config" -printf '%p %u:%g:%m %n\n' | LC_ALL=C sort > "$journal/permissions.pending"
  find "$config" -type f -exec sha256sum '{}' + > "$journal/configured.pending"
  sync -f "$config"
  mv "$journal/permissions.pending" "$journal/permissions"
  mv "$journal/configured.pending" "$journal/configured.sha256"
  sync -f "$journal"
  fi
  # A crash while publishing completion may leave only this owned temporary file.
  rm -f -- "$config/installed.pending"
  [ -z "$(find "$config" -type l -print)" ] || fail 'unexpected configuration symlink'
  find "$config" -printf '%p %u:%g:%m %n\n' | LC_ALL=C sort > "$journal/permissions.check"
  cmp -s "$journal/permissions" "$journal/permissions.check" || fail 'configuration permissions changed during interrupted setup'
  rm "$journal/permissions.check"
  sha256sum --check --status "$journal/configured.sha256" || fail 'installed configuration changed during interrupted setup'
  systemctl start postgresql
  runuser -u postgres -- env PGHOST=/var/run/postgresql PGPORT=5432 PGDATABASE=postgres PGUSER=postgres ecx_bridge_datadir="$target/share" \
    "$target/bin/ecx-bridge" provision-database < "$journal/owner"
  # Ordered, database-specific peer rules. No password or broad trust rule.
  if ! grep -qxF 'local ecx_bridge all peer map=ecx_bridge_install' /etc/postgresql/16/main/pg_hba.conf; then
    sed -i '1i local ecx_bridge all peer map=ecx_bridge_install' /etc/postgresql/16/main/pg_hba.conf
  fi
  for rule in 'ecx_bridge_install postgres postgres' 'ecx_bridge_install ecxbridgew ecxbridgew' 'ecx_bridge_install ecxbridgew ecxbridger' 'ecx_bridge_install ecxbridges ecxbridges'; do
    grep -qxF "$rule" /etc/postgresql/16/main/pg_ident.conf || printf '%s\n' "$rule" >> /etc/postgresql/16/main/pg_ident.conf
  done
  pg_ctlcluster 16 main reload
else
  systemctl stop ecx-bridge-worker ecx-bridge-signer
fi
# Publishing a release never changes keys, configuration, ledger or saved attempts.
[ ! -e "$prefix/current.new" ] || [ -L "$prefix/current.new" ] || fail 'unexpected current staging path'
ln -sfn "$target" "$prefix/current.new"
mv -Tf "$prefix/current.new" "$prefix/current"
if [ "$mode" = fresh ]; then
  deployment_identity=$("$prefix/current/bin/ecx-bridge" check-config "$config/worker/config.json" | jq -er .fingerprint)
  # Only the offline database owner installs constraints. The worker keeps DML
  # privileges and never gains schema ownership or access to another role's files.
  runuser -u postgres -- env PGHOST=/var/run/postgresql PGPORT=5432 PGDATABASE=ecx_bridge PGUSER=postgres ecx_bridge_datadir="$prefix/current/share" \
    "$prefix/current/bin/ecx-bridge" initialize-ledger --fingerprint "$deployment_identity"
  runuser -u "$worker" -- env PGHOST=/var/run/postgresql PGPORT=5432 PGDATABASE=ecx_bridge PGUSER="$worker" \
    "$prefix/current/bin/ecx-bridge" adopt-ledger "$config/worker/config.json" 0
fi
for role in worker signer; do
  if [ "$role" = worker ]; then
    account=$worker; args="serve $config/worker/config.json"; extra="Environment=PGREADUSER=$reader"
  else
    account=$signer; args="signer $config/signer/config.json $config/signer/solana.keypair.json"; extra=
    if [ -f "$config/signer/backup.json" ]; then args="$args $config/signer/backup.json $state/signer"; fi
  fi
  cat > "/etc/systemd/system/ecx-bridge-$role.service" <<UNIT
[Unit]
Description=ECX bridge $role
ConditionPathExists=$config/installed
After=postgresql.service network-online.target
Requires=postgresql.service
Wants=network-online.target
[Service]
User=$account
Group=$account
UMask=0077
Environment=PGHOST=/var/run/postgresql
Environment=PGPORT=5432
Environment=PGDATABASE=ecx_bridge
Environment=PGUSER=$account
Environment=ECX_ASSETS=$prefix/current/share/web
Environment=ecx_bridge_datadir=$prefix/current/share
$extra
ExecStart=$prefix/current/bin/ecx-bridge $args
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$state/$role
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64
[Install]
WantedBy=multi-user.target
UNIT
  if [ "$role" = worker ]; then
    dropin=/etc/systemd/system/ecx-bridge-worker.service.d
    install -d -m 0755 "$dropin"
    {
      printf '%s\n' '[Service]'
      if [ -f "$config/worker/interface.json" ]; then
        printf '%s\n' "Environment=ECX_INTERFACE_CONFIG=$config/worker/interface.json"
      fi
      if [ -f "$config/worker/public-fullchain.pem" ]; then
        printf '%s\n' "Environment=ECX_PUBLIC_TLS_CERT=$config/worker/public-fullchain.pem" "Environment=ECX_PUBLIC_TLS_KEY=$config/worker/public-privkey.pem"
        if [ "$(jq -r .serverPort "$config/worker/config.json")" -lt 1024 ]; then
          printf '%s\n' 'AmbientCapabilities=CAP_NET_BIND_SERVICE' 'CapabilityBoundingSet=CAP_NET_BIND_SERVICE'
        fi
      fi
    } > "$dropin/30-configure.conf"
    chmod 0644 "$dropin/30-configure.conf"
  fi
  chmod 0644 "/etc/systemd/system/ecx-bridge-$role.service"
done
# A no-login shell alone still permits SSH forwarding with an authorized key.
if [ -x /usr/sbin/sshd ]; then
  install -d -m 0755 /etc/ssh/sshd_config.d
  printf '%s\n' 'DenyUsers ecxbridgew ecxbridges' > /etc/ssh/sshd_config.d/70-ecx-bridge.conf
  chown root:root /etc/ssh/sshd_config.d/70-ecx-bridge.conf
  chmod 0644 /etc/ssh/sshd_config.d/70-ecx-bridge.conf
  /usr/sbin/sshd -t
  denied=$(/usr/sbin/sshd -T | sed -n 's/^denyusers //p' | tr '\n' ' ')
  for account in "$worker" "$signer"; do
    case " $denied " in *" $account "*) ;; *) fail 'sshd must include bridge account denial';; esac
  done
  systemctl try-reload-or-restart ssh.service
fi
systemctl daemon-reload
systemctl enable ecx-bridge-worker ecx-bridge-signer
printf '%s\n' "$release" > "$config/installed.pending"
sync -f "$config"
mv "$config/installed.pending" "$config/installed"
sync -f "$config"
echo 'Installed. Services are STOPPED. Configure native wallet backup staging/HTTPS, verify backup and isolation, then start services; the worker starts paused. Explicit checked resume is required.'
