#!/bin/sh
# Fixed managed-node export only. No caller-supplied paths, wallet or command.
set -eu
umask 077
fail() { echo "Native backup setup: $*" >&2; exit 1; }
[ "$#" = 0 ] && [ "$(id -u)" = 0 ] || fail 'root, no arguments required'
bundle=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
case "$bundle" in /opt/ecx-bridge/releases/*) ;; *) fail 'installed verified release directory required';; esac
(cd "$bundle" && sha256sum --check --status manifest.sha256) || fail 'release changed'
exec 9>/run/lock/ecx-native-backup-install.lock
flock -n 9 || fail 'another native backup installation is running'
# Publish on the destination filesystem. A partial staging copy is never live;
# retry may replace only our fixed root-owned, single-link staging file.
publish() {
  source=$1; destination=$2; group=$3; mode=$4
  pending=$destination.ecx-pending
  if [ -e "$pending" ] || [ -L "$pending" ]; then
    [ -f "$pending" ] && [ ! -L "$pending" ] && [ "$(stat -c '%u:%h' "$pending")" = 0:1 ] || fail 'unsafe publication staging file'
    permissions=$(stat -c %a "$pending")
    [ "$((0$permissions & 022))" = 0 ] || fail 'unsafe publication staging permissions'
    rm -- "$pending"
  fi
  install -o root -g "$group" -m "$mode" "$source" "$pending"
  sync -f "$pending"
  mv -Tf "$pending" "$destination"
  sync -f "$(dirname -- "$destination")"
}
config=/etc/ecx-bridge/signer/config.json
[ -f "$config" ] && [ ! -L "$config" ] || fail 'installed signer configuration required'
[ "$(systemctl show ecx-betanet --property=User --value)" = ecxnode ] || fail 'managed ecxnode service required'
[ "$(jq -r .nativeRpc "$config")" = http://127.0.0.1:28532 ] || fail 'managed node RPC required'
base=/etc/ecx-native-backup
spool=/var/lib/ecx-betanet/bridge-backup
for directory in "$base" "$spool" /run/ecx-native-backup; do
  [ ! -L "$directory" ] || fail 'symlink directory refused'
done
install -d -o root -g ecxnode -m 0750 "$base"
install -d -o ecxnode -g ecxnode -m 0700 "$spool"
staging=$(mktemp -d "$base/.install-XXXXXXXX")
trap 'rm -rf -- "$staging"' EXIT
jq '{profile,nativeRpc,nativeWallet,nativeCheckpointHeight,nativeCheckpointHash,nativeCookie:"/var/lib/ecx-betanet/.cookie"}' "$config" > "$staging/config.json"
if [ -e "$base/config.json" ]; then
  [ ! -L "$base/config.json" ] && cmp -s "$base/config.json" "$staging/config.json" || fail 'native backup identity changed'
else
  publish "$staging/config.json" "$base/config.json" ecxnode 0640
fi
cat > "$staging/tmpfiles" <<'CONF'
d /run/ecx-native-backup 0750 root ecxbridges -
CONF
publish "$staging/tmpfiles" /etc/tmpfiles.d/ecx-native-backup.conf root 0644
systemd-tmpfiles --create /etc/tmpfiles.d/ecx-native-backup.conf
cat > "$staging/socket" <<'UNIT'
[Unit]
Description=Private ECX native wallet backup export
[Socket]
ListenStream=/run/ecx-native-backup/export.sock
SocketUser=root
SocketGroup=ecxbridges
SocketMode=0660
Accept=yes
MaxConnections=2
[Install]
WantedBy=sockets.target
UNIT
cat > "$staging/service" <<UNIT
[Unit]
Description=Bounded native wallet backup export
After=ecx-betanet.service
Requires=ecx-betanet.service
[Service]
User=ecxnode
Group=ecxnode
ExecStart=$bundle/bin/ecx-bridge native-backup-service /etc/ecx-native-backup/config.json /var/lib/ecx-betanet/bridge-backup
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/etc/ecx-bridge -/var/lib/ecx-bridge -/var/lib/postgresql -/run/postgresql
ReadWritePaths=/var/lib/ecx-betanet/bridge-backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RuntimeMaxSec=250
TimeoutStopSec=5
MemoryMax=256M
TasksMax=16
LimitCORE=0
UNIT
# Drain the old executable before replacing its unit. An interrupted node RPC
# keeps its bounded spool directory for explicit recovery; never delete it here.
systemctl stop ecx-native-backup.socket 2>/dev/null || {
  [ ! -e /etc/systemd/system/ecx-native-backup.socket ] || fail 'cannot stop backup socket'
}
systemctl stop 'ecx-native-backup@*.service'
[ -z "$(systemctl list-units --all --state=active,activating,deactivating --no-legend 'ecx-native-backup@*.service')" ] || fail 'backup exporter still running'
publish "$staging/socket" /etc/systemd/system/ecx-native-backup.socket root 0644
publish "$staging/service" /etc/systemd/system/ecx-native-backup@.service root 0644
sync -f "$base"
sync -f /etc/systemd/system
systemctl daemon-reload
systemctl enable --now ecx-native-backup.socket
echo 'Installed bounded native wallet backup handoff; node and signer identities remain separate.'
