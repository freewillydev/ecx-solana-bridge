cabal-version: 3.14
name: ecx-bridge
version: 0.1.0.0
synopsis: Inventory bridge for real L2L Signet and ECX networks
description: Development implementation of an inventory bridge with a durable
             ledger, private worker, typed API, and fixed Solana transaction helper.
category: Finance
license: MIT
license-file: LICENSE
build-type: Simple
extra-source-files: migrations/postgresql/*.sql, config/*.json, web/*.html, web/*.css, web/*.hs, web/*.cabal, web/cabal.project*, docs/*.md,
                    test/fixtures/*.json, solana-helper/Cargo.toml, solana-helper/Cargo.lock,
                    solana-helper/src/lib.rs, rust-toolchain.toml

common settings
  default-language: GHC2021
  default-extensions: OverloadedStrings, DeriveGeneric, DeriveAnyClass, LambdaCase, RecordWildCards
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

-- No database, RPC, signing or evaluation implementation in these components.
library bridge-types
  import: settings
  visibility: private
  hs-source-dirs: types
  exposed-modules: Bridge.Model, Bridge.Types, Bridge.Ledger.Model,
                   Bridge.Operation, Bridge.Operation.Internal
  build-depends: base >=4.20 && <4.23, aeson >=2.2 && <2.4,
    base16-bytestring >=1 && <1.1, bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.9, crypton >=1 && <1.2, ram >=0.22 && <0.23,
    text >=2.1 && <2.2

library customer-api
  import: settings
  visibility: private
  hs-source-dirs: api
  exposed-modules: Bridge.API
  build-depends: base >=4.20 && <4.23, ecx-bridge:bridge-types,
    servant >=0.20 && <0.21, servant-server >=0.20 && <0.21,
    text >=2.1 && <2.2
  mixins: ecx-bridge:bridge-types hiding (Bridge.Operation.Internal)

library bridge-runtime
  import: settings
  visibility: private
  hs-source-dirs: src
  reexported-modules: Bridge.SDKBuild, Bridge.BrowserBuild
  other-modules: Bridge.Postgres.Catalog
  exposed-modules: Bridge.Control, Bridge.Operator, Bridge.Signer, Bridge.Postgres.FeeWithdrawal, Bridge.Postgres.Treasury, Bridge.Postgres.Fence, Bridge.Postgres.Backup, Bridge.Postgres.LossCover, Bridge.Postgres.Replacement, Bridge.Postgres.NativeRecovery, Bridge.Postgres.Maintenance, Bridge.Postgres.Startup, Bridge.SolanaPay, Bridge.Postgres.Runtime, Bridge.Postgres.Settlement, Bridge.Postgres.Preparation, Bridge.Postgres.Custody, Bridge.Postgres.Source, Bridge.Postgres.Observation, Bridge.Postgres.Order, Bridge.Postgres.Ledger, Bridge.Postgres.Schema, Bridge.Config, Bridge.Reconciliation, Bridge.Recovery, Bridge.Reorg, Bridge.RPC, Bridge.Native, Bridge.NativePayment, Bridge.NativeReplacement, Bridge.Payment, Bridge.Settlement, Bridge.Order, Bridge.Admission, Bridge.Solana, Bridge.SolanaHelper, Bridge.SolanaPayment, Bridge.SolanaMessage, Bridge.SolanaDeposit, Bridge.Observer, Bridge.Process, Bridge.Web
  build-depends:
    ecx-bridge:bridge-types, ecx-bridge:customer-api, ecx-build-assets,
    base >=4.20 && <4.23, aeson >=2.2 && <2.4, async >=2.2 && <2.3,
    base16-bytestring >=1 && <1.1, base58-bytestring >=0.1 && <0.2,
    base64-bytestring >=1.2 && <1.3, binary >=0.8 && <0.9,
    bytestring >=0.11 && <0.13, containers >=0.6 && <0.9,
    crypton >=1 && <1.2, directory >=1.3 && <1.4, filepath >=1.4 && <1.6,
    filelock >=0.1 && <0.2, http-client >=0.7 && <0.8,
    http-client-tls >=0.4 && <0.5, http-types >=0.12 && <0.13,
    ram >=0.22 && <0.23, network >=3.1 && <3.3,
    process >=1.6 && <1.7, scientific >=0.3 && <0.4,
    servant >=0.20 && <0.21, servant-client >=0.20 && <0.21, servant-server >=0.20 && <0.21,
    product-profunctors >=0.11 && <0.12,
    opaleye ==0.10.8.0, postgresql-simple >=0.7 && <0.8,
    transformers >=0.6 && <0.7, stm >=2.5 && <2.6, text >=2.1 && <2.2, time >=1.12 && <1.16,
    unix >=2.8 && <2.9, wai >=3.2 && <3.3, wai-extra >=3.1 && <3.2,
    warp >=3.3 && <3.5, warp-tls ==3.4.14,
    tls ==2.4.4, crypton-connection ==0.4.6, crypton-pem ==0.3.0,
    crypton-x509 >=1.9.1 && <1.10, crypton-x509-store >=1.9 && <1.10

executable ecx-bridge
  import: settings
  hs-source-dirs: scripts
  main-is: server.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  build-depends: base, ecx-bridge:bridge-types, ecx-bridge:customer-api, ecx-bridge:bridge-runtime, postgresql-simple, unix, aeson, bytestring, text

test-suite bridge-test
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  ghc-options: -threaded
  build-depends: base, ecx-bridge:bridge-types, ecx-bridge:customer-api, ecx-bridge:bridge-runtime, aeson, bytestring, containers, directory, filepath,
    hspec >=2.11 && <2.12, QuickCheck >=2.15 && <2.19,
    text, time, async, network, http-client, servant-client, servant, servant-server, postgresql-simple, unix, scientific, base64-bytestring,
    crypton, ram, wai, wai-extra, warp, warp-tls, http-types, process,
    http-client-tls, crypton-connection, tls, crypton-x509-store,
    data-default, crypton-pem, crypton-x509, crypton-x509-validation

-- One database contract runner; every row operation uses a closed Opaleye fixture.
executable ecx-postgres-check
  import: settings
  hs-source-dirs: integration
  main-is: JournalCheck.hs
  other-modules: SourceApprovalCheck, AuthorityCheck
  build-depends: base, ecx-bridge:bridge-types, ecx-bridge:bridge-runtime,
    aeson, async, bytestring, containers, directory, filepath, opaleye,
    postgresql-simple, process, QuickCheck, text, unix
