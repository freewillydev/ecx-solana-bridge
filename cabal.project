-- GHC 9.14/base 4.22 and containers 0.8 exceed these packages' declared
-- bounds. Keep exceptions package-specific and verify compilation/regressions;
-- serialise/time uses the already selected modern time API (+newtime15).
allow-newer: opaleye:base, postgresql-simple:base, postgresql-simple:template-haskell, postgresql-simple:containers, postgresql-simple:aeson, serialise:base, serialise:time, serialise:containers, cborg:base, cborg:containers

